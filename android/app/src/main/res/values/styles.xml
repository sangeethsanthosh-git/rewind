<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.Rewind" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/rewind_background</item>
        <item name="android:navigationBarColor">@color/rewind_background</item>
        <item name="android:windowBackground">@color/rewind_background</item>
    </style>

    <!-- Native SplashScreen Theme -->
    <style name="Theme.Rewind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rewind_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Rewind</item>
    </style>
</resources>
